# Provedor de LLM ativo (openai, anthropic, google, ollama)
LLM_PROVIDER=openai

# Chaves de API dos provedores de LLM
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
GOOGLE_API_KEY=sua_chave_google_aqui

# Modelo LLM padrão
LLM_MODEL=gpt-4o-mini

# Temperatura do LLM
LLM_TEMPERATURE=0.7

# Provedor de geração de imagem (dalle3, stable_diffusion, midjourney)
IMAGE_PROVIDER=dalle3

# Chaves de API para geração de imagem
OPENAI_IMAGE_API_KEY=sua_chave_openai_aqui
STABILITY_API_KEY=sua_chave_stability_aqui
MIDJOURNEY_API_KEY=sua_chave_midjourney_aqui

# Provedor de geração de vídeo (runway, pika, sora, stable_video)
VIDEO_PROVIDER=runway

# Chaves de API para geração de vídeo
RUNWAY_API_KEY=sua_chave_runway_aqui
PIKA_API_KEY=sua_chave_pika_aqui
SORA_API_KEY=sua_chave_sora_aqui

# Configurações de marketplace (exemplo genérico)
MARKETPLACE_API_URL=https://api.marketplace.exemplo.com
MARKETPLACE_API_KEY=sua_chave_marketplace_aqui
MARKETPLACE_SELLER_ID=seu_id_vendedor

# Pasta base para salvamento local de vídeos
OUTPUT_FOLDER=./output